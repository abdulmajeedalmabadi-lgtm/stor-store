{
  "name": "stor-mysql-store",
  "version": "3.0.0",
  "private": true,
  "description": "متجر STOR — واجهات عربية وخادم MySQL وحسابات العملاء والأدمن والبريد",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "config:init": "node scripts/init-config.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node scripts/init-database.js",
    "admin:create": "node scripts/create-admin.js",
    "mail:work": "node server/mail/worker.js",
    "format": "prettier --write \"server/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"dist/*.{html,css,js}\"",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "smtp-server": "^3.19.22"
  }
}
